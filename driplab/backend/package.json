{
  "name": "driplab-backend",
  "version": "1.0.0",
  "description": "API REST da plataforma DripLab (Node.js + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "test": "node --no-warnings --test test/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "license": "MIT",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": ""
}
